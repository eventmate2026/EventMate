PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/EventMate?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Frontend origins used for CORS and absolute links in emails/QRs.
# Add your production frontend first, then optional local/dev URLs.
FRONTEND_URLS=https://your-frontend-domain.com,http://localhost:5173
FRONTEND_URL=https://your-frontend-domain.com

# Email provider: use `smtp` for Gmail app password, or `sendgrid` for domain-authenticated SendGrid.
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=EventMate
EMAIL_FROM_EMAIL=yourgmail@gmail.com
EMAIL_REPLY_TO=yourgmail@gmail.com

# Gmail SMTP with App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=replace-with-gmail-app-password

# SendGrid
SENDGRID_API_KEY=replace-with-sendgrid-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
